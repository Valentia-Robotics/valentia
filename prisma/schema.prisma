// ============================================================
//  ESQUEMA DE LA BASE DE DATOS DE VALENTIA (MongoDB)
//  Cada "model" es una colección. Los datos iniciales están en data/*.json
//  y se cargan con "npm run db:seed".
// ============================================================

generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  // "native" = el sistema donde se ejecuta "prisma generate" (Windows en local, Linux en Render).
  // debian-openssl-3.0.x = el Linux de Render (OpenSSL 3), por si se genera en otro sitio.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

// MongoDB Atlas (en local, el clúster de desarrollo; en producción, el de "valentia-prod").
// MongoDB no usa migraciones: "npm run db:push" crea las colecciones y los índices (ver README).
datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Categoria {
  PLACAS
  MOTORES
  SENSORES
  ALIMENTACION
  CHASIS
  EXTRAS
}

enum TipoEjercicio {
  TEST
  RETO
}

/// Un componente que se vende suelto o dentro de un kit
model Componente {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  slug             String    @unique
  nombre           String
  categoria        Categoria
  /// Tipo concreto (placa, motor-dc, servo, driver-motores, bateria…). Lo usan las reglas de compatibilidad.
  tipo             String
  resumen          String
  descripcion      String
  precioCentimos   Int
  stock            Int
  imagen           String
  /// Tensión de funcionamiento en voltios (en una batería: la tensión que entrega)
  voltaje          Float
  /// Tensión lógica de las señales (3,3 V o 5 V), si aplica
  voltajeLogico    Float?
  /// Consumo típico en miliamperios (en una batería: la corriente máxima que puede dar)
  consumoMa        Int
  conector         String
  /// Pines de la placa que ocupa (en una placa: los pines que ofrece)
  pines            Int
  /// Datos técnicos extra para mostrar en la ficha, como lista de pares nombre/valor
  especificaciones Json
  /// false = oculto: no sale en /componentes ni en el configurador (pero sigue dentro de sus kits)
  visible          Boolean   @default(true)

  enKits KitComponente[]
}

/// Un kit cerrado de Valentia (por ejemplo, el coche seguidor de líneas)
model Kit {
  id             String  @id @default(auto()) @map("_id") @db.ObjectId
  slug           String  @unique
  nombre         String
  eslogan        String
  descripcion    String
  precioCentimos Int
  imagen         String
  nivel          String
  edadMinima     Int
  tiempoMontaje  String
  /// El kit destacado aparece en la portada
  destacado      Boolean @default(false)
  orden          Int     @default(0)
  /// Puntos fuertes del kit (lista de textos)
  puntosFuertes  Json
  /// false = oculto: no se vende ni aparece en la tienda (sus códigos siguen funcionando)
  visible        Boolean @default(true)

  componentes KitComponente[]
  curso       Curso              @relation(fields: [cursoId], references: [id])
  cursoId     String             @unique @db.ObjectId
  codigos     CodigoActivacion[]
  lotes       LoteCodigos[]
  resenas     Resena[]
  guiones     Guion[]
}

/// Qué componentes (y cuántos) lleva cada kit
model KitComponente {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  kit          Kit        @relation(fields: [kitId], references: [id], onDelete: Cascade)
  kitId        String     @db.ObjectId
  componente   Componente @relation(fields: [componenteId], references: [id], onDelete: Cascade)
  componenteId String     @db.ObjectId
  cantidad     Int        @default(1)

  @@unique([kitId, componenteId])
}

/// El curso que acompaña a un kit
model Curso {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  slug        String         @unique
  titulo      String
  descripcion String
  nivel       String
  lecciones   Leccion[]
  kit         Kit?
  alumnos     CursoUsuario[]
}

model Leccion {
  id             String            @id @default(auto()) @map("_id") @db.ObjectId
  curso          Curso             @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  cursoId        String            @db.ObjectId
  slug           String
  orden          Int
  titulo         String
  descripcion    String
  /// URL del vídeo (YouTube, Vimeo o .mp4). "PENDIENTE" = todavía no hay vídeo.
  videoUrl       String
  duracionMin    Int
  ejercicios     Ejercicio[]
  progreso       ProgresoLeccion[]
  videosVistos   VideoVisto[]
  resultadosTest ResultadoTest[]

  @@unique([cursoId, slug])
}

/// Ejercicio de una lección: un test de opción múltiple o un reto práctico
model Ejercicio {
  id          String              @id @default(auto()) @map("_id") @db.ObjectId
  leccion     Leccion             @relation(fields: [leccionId], references: [id], onDelete: Cascade)
  leccionId   String              @db.ObjectId
  orden       Int
  tipo        TipoEjercicio
  enunciado   String
  /// Solo TEST: lista de respuestas posibles
  opciones    Json?
  /// Solo TEST: posición (empezando en 0) de la respuesta correcta
  correcta    Int?
  explicacion String?
  /// Solo RETO: pistas que se van desbloqueando
  pistas      Json?
  /// Solo RETO: solución que se puede desbloquear
  solucion    String?
  progreso    ProgresoEjercicio[]
}

// ============================================================
//  PEDIDOS (fase 4)
// ============================================================

/// Vida de un pedido. PENDIENTE → PAGADO (solo lo marca el pago confirmado) → PREPARANDO
/// → ENVIADO → ENTREGADO. CANCELADO: pago no completado o cancelado desde el panel.
enum EstadoPedido {
  PENDIENTE
  PAGADO
  PREPARANDO
  ENVIADO
  ENTREGADO
  CANCELADO
}

enum TipoLinea {
  KIT
  COMPONENTE
  CONFIGURACION
}

/// Un pedido de la tienda. Se guarda una copia de los datos (nombres y precios)
/// para que el pedido no cambie aunque luego cambie el catálogo.
model Pedido {
  id                   String       @id @default(auto()) @map("_id") @db.ObjectId
  /// Número que ve el cliente, por ejemplo VAL-2026-4F7K9Q
  numero               String       @unique
  /// Cuenta que hizo el pedido (vacío si compró como invitado)
  usuario              Usuario?     @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  usuarioId            String?      @db.ObjectId
  nombre               String
  email                String
  telefono             String       @default("")
  direccion            String
  codigoPostal         String
  ciudad               String
  provincia            String       @default("")
  /// Importes en céntimos, IVA incluido (calculados en el servidor, ver src/lib/precios.ts)
  subtotalCentimos     Int          @default(0)
  envioCentimos        Int          @default(0)
  /// IVA incluido en el total
  ivaCentimos          Int          @default(0)
  totalCentimos        Int
  estado               EstadoPedido @default(PENDIENTE)
  /// Quién cobra el pedido: "simulado" (sin claves de Stripe) o "stripe"
  proveedorPago        String
  /// Referencia del pago que da el proveedor (en Stripe, el id del PaymentIntent)
  referenciaPago       String?
  /// Número de seguimiento del transportista (lo pone el panel al enviarlo)
  numeroSeguimiento    String?
  /// Cuándo aceptó las condiciones de venta
  aceptaCondicionesEn  DateTime?
  creadoEn             DateTime     @default(now())
  actualizadoEn        DateTime     @default(now()) @updatedAt
  pagadoEn             DateTime?
  enviadoEn            DateTime?
  entregadoEn          DateTime?
  canceladoEn          DateTime?
  /// Cuándo se envió el correo de confirmación (para no mandarlo dos veces)
  correoConfirmacionEn DateTime?

  lineas  LineaPedido[]
  codigos CodigoActivacion[]

  @@index([usuarioId])
  @@index([email])
  @@index([estado, creadoEn])
  @@index([referenciaPago])
}

/// Dirección de envío guardada en una cuenta (se elige en el checkout)
model Direccion {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  usuario        Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId      String   @db.ObjectId
  nombre         String
  telefono       String
  direccion      String
  codigoPostal   String
  ciudad         String
  provincia      String
  predeterminada Boolean  @default(false)
  creadoEn       DateTime @default(now())

  @@index([usuarioId])
}

/// Avisos (webhooks) de Stripe ya procesados: si Stripe repite uno, no se procesa dos veces
model EventoStripe {
  /// id del evento de Stripe (evt_…)
  id         String   @id @map("_id")
  tipo       String
  recibidoEn DateTime @default(now())
}

/// Una línea del pedido: un kit, un componente suelto o un robot personalizado
model LineaPedido {
  id                     String    @id @default(auto()) @map("_id") @db.ObjectId
  pedido                 Pedido    @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  pedidoId               String    @db.ObjectId
  tipo                   TipoLinea
  nombre                 String
  /// slug del kit o del componente (vacío en un robot personalizado)
  slug                   String?
  precioUnitarioCentimos Int
  cantidad               Int
  /// Solo robot personalizado: lista de piezas [{ slug, nombre, cantidad }]
  piezas                 Json?
}

/// Código único que va impreso (con su QR) en la caja de cada kit.
/// Al activarlo, el curso del kit queda en "Mis cursos" del usuario (fase 5).
model CodigoActivacion {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  /// El código en sí, por ejemplo VAL-7KQ2-M9XD
  codigo        String       @unique
  kit           Kit          @relation(fields: [kitId], references: [id], onDelete: Cascade)
  kitId         String       @db.ObjectId
  /// Pedido en el que se vendió (vacío en los códigos de prueba del seed)
  pedido        Pedido?      @relation(fields: [pedidoId], references: [id], onDelete: SetNull)
  pedidoId      String?      @db.ObjectId
  creadoEn      DateTime     @default(now())
  /// Cuándo se activó. Vacío = todavía sin usar
  usadoEn       DateTime?
  /// Quién lo activó
  usuario       Usuario?     @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  usuarioId     String?      @db.ObjectId
  /// Desactivado desde el panel: ya no sirve para activar (quien lo activó antes conserva el curso)
  desactivadoEn DateTime?
  /// Lote de impresión en el que se generó (vacío en los códigos creados al pagar un pedido)
  lote          LoteCodigos? @relation(fields: [loteId], references: [id], onDelete: SetNull)
  loteId        String?      @db.ObjectId
}

/// Grupo de códigos generados de una vez desde el panel para imprimirlos y meterlos en las cajas
model LoteCodigos {
  id       String             @id @default(auto()) @map("_id") @db.ObjectId
  kit      Kit                @relation(fields: [kitId], references: [id], onDelete: Cascade)
  kitId    String             @db.ObjectId
  cantidad Int
  creadoEn DateTime           @default(now())
  codigos  CodigoActivacion[]
}

// ============================================================
//  USUARIOS, CURSOS Y PROGRESO (fase 5)
// ============================================================

/// Qué puede hacer cada cuenta. El registro público siempre crea CLIENTE.
/// Para hacer ADMIN a alguien: npm run admin -- su@email.com
enum Rol {
  CLIENTE
  ADMIN
  /// Edita los vídeos de marketing: solo ve /editor y los guiones que tiene asignados
  EDITOR
}

/// Una persona con cuenta en Valentia
model Usuario {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  nombre            String
  /// Siempre en minúsculas
  email             String    @unique
  /// La contraseña cifrada con bcrypt (nunca se guarda la contraseña tal cual)
  contrasenaHash    String
  rol               Rol       @default(CLIENTE)
  creadoEn          DateTime  @default(now())
  /// Cuándo confirmó su email con el código (null = sin confirmar: no puede entrar ni activar cursos)
  emailVerificadoEn DateTime?

  cursos         CursoUsuario[]
  codigos        CodigoActivacion[]
  lecciones      ProgresoLeccion[]
  ejercicios     ProgresoEjercicio[]
  verificaciones Verificacion[]
  dispositivos   DispositivoConfianza[]
  pedidos        Pedido[]
  direcciones    Direccion[]
  videosVistos   VideoVisto[]
  resultadosTest ResultadoTest[]
  resenas        Resena[]

  guionesAsignados Guion[]             @relation("GuionEditor")
  guionesCreados   Guion[]             @relation("GuionAutor")
  cambiosGuion     CambioEstadoGuion[]
}

/// Para qué se ha enviado un código por email
enum MotivoVerificacion {
  /// Confirmar el email de una cuenta nueva
  REGISTRO
  /// Iniciar sesión desde un dispositivo nuevo
  DISPOSITIVO
  /// Cambiar la contraseña olvidada
  RECUPERAR
}

/// Una verificación por código en curso (ver src/lib/verificacion).
/// El navegador la reconoce por una cookie con un token al azar; aquí solo se guarda su hash.
model Verificacion {
  id           String             @id @default(auto()) @map("_id") @db.ObjectId
  /// SHA-256 del token de la cookie (nunca el token tal cual)
  tokenHash    String             @unique
  /// null en las verificaciones "señuelo" (email sin cuenta o ya registrado): parecen
  /// iguales por fuera para no desvelar qué emails tienen cuenta, pero ningún código vale
  usuario      Usuario?           @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId    String?            @db.ObjectId
  /// El email al que se ha enviado (en minúsculas)
  email        String
  motivo       MotivoVerificacion
  /// HMAC-SHA256 del código de 6 cifras (nunca el código tal cual)
  codigoHash   String
  intentos     Int                @default(0)
  caducaEn     DateTime
  /// Último envío del código (para la espera entre reenvíos)
  enviadoEn    DateTime
  /// Cuándo se escribió el código correcto
  confirmadoEn DateTime?
  /// Cuándo se terminó del todo (sesión iniciada o contraseña cambiada): ya no sirve
  usadoEn      DateTime?
  creadoEn     DateTime           @default(now())

  @@index([email, motivo])
}

/// Cada envío de un código, para el límite de envíos por hora de cada email
model EnvioCodigo {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  enviadoEn DateTime @default(now())

  @@index([email, enviadoEn])
}

/// Un navegador en el que el usuario ha confirmado con un código que es él.
/// Cada sesión va unida a uno: si se borra, esa sesión se cierra.
model DispositivoConfianza {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  usuario         Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId       String    @db.ObjectId
  /// SHA-256 del token guardado en la cookie del navegador (nunca el token tal cual)
  tokenHash       String    @unique
  /// Nombre legible, por ejemplo "Chrome en Windows"
  nombre          String
  creadoEn        DateTime  @default(now())
  ultimoUsoEn     DateTime  @default(now())
  /// 30 días para clientes, 7 para administradores
  caducaEn        DateTime
  /// "Pase" de un solo uso (hash) que convierte esta confianza en una sesión de Auth.js
  paseHash        String?
  paseCaducaEn    DateTime?
  /// Último "Cerrar sesión" en este navegador: las sesiones abiertas antes ya no valen
  sesionCerradaEn DateTime?

  @@index([usuarioId])
  @@index([paseHash])
}

/// Un curso desbloqueado por un usuario (al activar el código de su kit)
model CursoUsuario {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  usuario        Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId      String   @db.ObjectId
  curso          Curso    @relation(fields: [cursoId], references: [id], onDelete: Cascade)
  cursoId        String   @db.ObjectId
  desbloqueadoEn DateTime @default(now())

  @@unique([usuarioId, cursoId])
}

/// Lección marcada como completada por un usuario
model ProgresoLeccion {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId    String   @db.ObjectId
  leccion      Leccion  @relation(fields: [leccionId], references: [id], onDelete: Cascade)
  leccionId    String   @db.ObjectId
  completadaEn DateTime @default(now())

  @@unique([usuarioId, leccionId])
}

/// El usuario ha visto el vídeo de la lección hasta el final (desbloquea el test)
model VideoVisto {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String   @db.ObjectId
  leccion   Leccion  @relation(fields: [leccionId], references: [id], onDelete: Cascade)
  leccionId String   @db.ObjectId
  vistoEn   DateTime @default(now())

  @@unique([usuarioId, leccionId])
}

/// Resultado del test de una lección (todas sus preguntas de tipo TEST)
model ResultadoTest {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  usuario       Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId     String   @db.ObjectId
  leccion       Leccion  @relation(fields: [leccionId], references: [id], onDelete: Cascade)
  leccionId     String   @db.ObjectId
  /// Aciertos y número de preguntas del último intento
  aciertos      Int
  total         Int
  /// Mejor número de aciertos de todos los intentos
  mejorAciertos Int
  intentos      Int      @default(1)
  actualizadoEn DateTime @updatedAt

  @@unique([usuarioId, leccionId])
}

/// Lo que ha hecho un usuario en un ejercicio
model ProgresoEjercicio {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  usuario       Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId     String    @db.ObjectId
  ejercicio     Ejercicio @relation(fields: [ejercicioId], references: [id], onDelete: Cascade)
  ejercicioId   String    @db.ObjectId
  /// TEST: última opción elegida y si era la correcta
  respuesta     Int?
  acertado      Boolean   @default(false)
  intentos      Int       @default(0)
  /// RETO: si ha desbloqueado la solución
  solucionVista Boolean   @default(false)
  actualizadoEn DateTime  @updatedAt

  @@unique([usuarioId, ejercicioId])
}

/// Contador del límite de intentos (ver src/lib/limite.ts). Se guarda en la base de datos para que
/// funcione igual con uno o con muchos servidores (hosting "serverless").
model LimiteIntento {
  /// acción:huella-de-la-clave:ventana (la IP o el email nunca se guardan tal cual)
  id       String   @id @map("_id")
  contador Int      @default(1)
  caducaEn DateTime

  @@index([caducaEn])
}

// ============================================================
//  RESEÑAS DE LOS KITS (ver src/lib/resenas.ts y src/config/resenas.ts)
// ============================================================

/// En qué punto está una reseña
enum EstadoResena {
  /// Escrita, esperando a que el administrador la publique (no se ve en la tienda)
  PENDIENTE
  /// Se ve en la ficha del kit y cuenta para la media de estrellas
  PUBLICADA
  /// Retirada desde el panel (no se ve; se puede volver a publicar)
  OCULTA
}

/// La opinión de un cliente sobre un kit: una por persona y kit (si la cambia, se sobrescribe)
model Resena {
  id            String       @id @default(auto()) @map("_id") @db.ObjectId
  kit           Kit          @relation(fields: [kitId], references: [id], onDelete: Cascade)
  kitId         String       @db.ObjectId
  usuario       Usuario      @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId     String       @db.ObjectId
  /// De 1 a 5
  estrellas     Int
  texto         String
  estado        EstadoResena @default(PENDIENTE)
  creadoEn      DateTime     @default(now())
  /// Última vez que el cliente la escribió o la cambió
  actualizadoEn DateTime     @default(now())

  @@unique([usuarioId, kitId])
  @@index([kitId, estado])
}

/// Personas que quieren que les avisemos cuando abra la tienda (formulario «Avísame»)
model ListaEspera {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  email     String    @unique
  /// Dónde se apuntó: "portada", "kit" o "checkout"
  origen    String
  /// Kit que estaba mirando al apuntarse (su slug), si lo hay
  kitSlug   String?
  creadoEn  DateTime  @default(now())
  /// Cuándo se le mandó el aviso de apertura
  avisadoEn DateTime?
}

/// Una página vista en la web pública (estadísticas propias, sin cookies ni IP).
/// Se borran solas a los 13 meses.
model Visita {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  /// Día en España, "2026-10-27"
  dia         String
  /// Página vista, sin parámetros ("/kits/coche-seguidor")
  ruta        String
  /// true si es la primera página al llegar a la web (las demás son navegación dentro)
  entrada     Boolean
  /// De dónde llegó ("Google", "Instagram"…); null = directo. Solo en las entradas.
  origen      String?
  /// "movil", "tableta" u "ordenador"
  dispositivo String
  /// Huella que cambia cada día (no se puede saber quién es): cuenta personas distintas
  visitante   String
  creadoEn    DateTime @default(now())

  @@index([dia])
  @@index([creadoEn])
}

// ============================================================
//  CATÁLOGO DE PRODUCCIÓN (npm run seed:prod)
// ============================================================

/// Memoria de seed:prod: qué ficha de data/catalogo/ creó o encontró ya hecha, en qué ficha de producción y con qué contenido
/// (huella). Sirve para no volver a crear lo borrado desde el panel (ver src/lib/catalogoProduccion.ts).
model CatalogoAplicado {
  /// "Coleccion:idDelJSON", por ejemplo "Kit:6ad5f9ba06cf870884abee1c"
  id         String   @id @map("_id")
  coleccion  String
  /// Id de la ficha en producción (casi siempre el mismo del JSON)
  prodId     String   @db.ObjectId
  /// sha256 del contenido del JSON la última vez que se aplicó
  hash       String
  aplicadoEn DateTime
}

/// Estados de un guion de marketing. Las reglas para pasar de uno a otro: src/config/estadosGuion.ts
enum EstadoGuion {
  BORRADOR
  PENDIENTE_APROBACION
  APROBADO
  ASIGNADO
  EN_PROGRESO
  ENTREGADO
  COMPLETADO
}

/// Dónde se publicará el vídeo
enum PlataformaGuion {
  VIDEO_CORTO
  YOUTUBE_LARGO
  OTRA
}

/// Quién escribió el guion (IA: reservado para la fase 2, «Generar borrador con IA»)
enum OrigenGuion {
  MANUAL
  IA
}

/// Temas de los guiones: lista cerrada que el admin puede ampliar (siempre tecnología y robótica)
model CategoriaGuion {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  nombre  String  @unique
  orden   Int     @default(0)
  /// false = ya no se puede elegir en guiones nuevos (los que la usan la conservan)
  activa  Boolean @default(true)
  guiones Guion[]
}

/// Un guion de un vídeo de marketing
model Guion {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  titulo           String
  categoria        CategoriaGuion  @relation(fields: [categoriaId], references: [id])
  categoriaId      String          @db.ObjectId
  plataforma       PlataformaGuion
  /// Solo con plataforma OTRA
  plataformaOtra   String?
  duracionObjetivo String
  /// Los primeros 3 segundos
  gancho           String
  desarrollo       String
  llamadaAccion    String
  notasVisuales    String
  kit              Kit?            @relation(fields: [kitId], references: [id], onDelete: SetNull)
  kitId            String?         @db.ObjectId
  /// A las 12:00 UTC del día elegido (así se lee el mismo día en cualquier zona horaria)
  fechaLimite      DateTime
  editor           Usuario?        @relation("GuionEditor", fields: [editorId], references: [id], onDelete: SetNull)
  editorId         String?         @db.ObjectId
  creadoPor        Usuario?        @relation("GuionAutor", fields: [creadoPorId], references: [id], onDelete: SetNull)
  creadoPorId      String?         @db.ObjectId
  estado           EstadoGuion     @default(BORRADOR)
  origen           OrigenGuion     @default(MANUAL)
  /// Zona de trabajo del editor: sus notas o su versión adaptada (el texto aprobado no se toca)
  notasEditor      String?
  /// Enlace al vídeo terminado (Drive, YouTube…)
  enlaceVideo      String?
  creadoEn         DateTime        @default(now())
  actualizadoEn    DateTime        @updatedAt

  historial CambioEstadoGuion[]

  @@index([estado])
  @@index([editorId])
}

/// Cada cambio de estado de un guion. Las métricas por editor salen de aquí.
model CambioEstadoGuion {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  guion          Guion        @relation(fields: [guionId], references: [id], onDelete: Cascade)
  guionId        String       @db.ObjectId
  /// null = al crear el guion
  estadoAnterior EstadoGuion?
  estadoNuevo    EstadoGuion
  /// Quién hizo el cambio. Se copia su nombre para no perderlo si la cuenta desaparece.
  usuario        Usuario?     @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  usuarioId      String?      @db.ObjectId
  usuarioNombre  String
  /// Editor del guion en ese momento: si se reasigna, cada editor conserva lo suyo en las métricas
  editorId       String?      @db.ObjectId
  /// Comentario de cambios del admin, o nota del sistema (reasignación)
  comentario     String?
  fecha          DateTime     @default(now())

  @@index([guionId])
  @@index([editorId])
}
