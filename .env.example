# Copia este archivo como ".env" y rellena los valores.
# Este archivo SÍ se sube a git, así que no pongas aquí secretos reales.

# Clave secreta de Auth.js. Genera una con: npx auth secret
AUTH_SECRET="pon-aqui-una-clave-larga-y-aleatoria"

# Base de datos. En local: SQLite. En producción: la URL de PostgreSQL.
DATABASE_URL="file:./prisma/dev.db"

# Dirección pública de la web
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Pagos: "simulado" (no cobra nada) o "stripe" (ver src/lib/pagos/stripe.ts)
PAGOS_PROVEEDOR="simulado"
