    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "2.16.2",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
