{
  "name": "valentia",
  "version": "0.1.0",
  "private": true,
  "description": "Web de Valentia: kits de robótica con cursos.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
