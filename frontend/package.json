    "clipper-lib": "^6.4.2",
    "dotenv": "18.0.8",
    "lucide-react": "^1.59.0",
    "marked": "18.1.2",
    "mongodb": "^6.21.0",
    "next": "16.4.5",
    "next-auth": "^5.0.0-beta.32",
    "prisma": "6.19.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "2.18.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "stripe": "^23.0.0",
    "three": "^0.186.1",
