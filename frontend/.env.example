# Copia este archivo como ".env" y rellena los valores.
# Este archivo SÍ se sube a git, así que no pongas aquí secretos reales.

# Clave secreta de Auth.js (sesiones y enlaces privados de los pedidos). Genera una con: npx auth secret
AUTH_SECRET="pon-aqui-una-clave-larga-y-aleatoria"

# Base de datos: MongoDB Atlas (ver README «Base de datos» y, para producción, DESPLIEGUE.md).
# En Atlas: Connect → Drivers. Pon el nombre de la base de datos justo antes del "?" (aquí, "valentia").
# Si el equipo comparte clúster, que cada persona use la suya: /valentia_ana?…
DATABASE_URL="mongodb+srv://usuario:contraseña@tu-cluster.xxxxx.mongodb.net/valentia?retryWrites=true&w=majority"

# Dirección pública de la web (los QR impresos y los enlaces de los correos apuntan aquí).
# En Render (producción): https://valentiarobotics.com
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Pagos con Stripe (ver README «Pagos») ───────────────────────────────
# Sin estas claves, el checkout usa el MODO DE PRUEBA («Confirmar pago de prueba», sin tarjeta).
# Usa SOLO claves de PRUEBA: dashboard.stripe.com → Desarrolladores → Claves de API (modo prueba).
STRIPE_SECRET_KEY=""                    # sk_test_…
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""   # pk_test_…
# Secreto del webhook: lo da "stripe listen" en local, o el panel de Stripe al crear el webhook
STRIPE_WEBHOOK_SECRET=""                # whsec_…
# Solo al publicar con claves reales (sk_live_/pk_live_): pon "si". Mientras, déjalo vacío.
STRIPE_PERMITIR_CLAVES_REALES=""
# En la web publicada, con claves de PRUEBA la compra está cerrada (nadie paga con tarjetas falsas).
# "si" la abre con claves de prueba, solo para probar.
STRIPE_PERMITIR_CLAVES_PRUEBA=""
# En la web publicada SIN Stripe, el pago de prueba está desactivado salvo que pongas "si".
PERMITIR_PAGO_SIMULADO=""

# Dónde se guardan las fotos subidas desde el panel:
# "local" (carpeta subidas/ del proyecto) o "nube" (ver src/lib/almacenamiento/nube.ts)
ALMACEN_PROVEEDOR="local"
# Con "local" y ALMACEN_PRIVADO_BUCKET (o en Render), las fotos del panel van al almacén privado
# (carpeta publicas/) con la misma dirección /subidas/…: así no se pierden al publicar.
# Solo con ALMACEN_PROVEEDOR="nube" (Cloudflare R2, Amazon S3, Backblaze B2…; ver README):
ALMACEN_ENDPOINT=""          # https://<cuenta>.r2.cloudflarestorage.com
ALMACEN_REGION="auto"        # R2: auto · S3: la región, por ejemplo eu-west-1
ALMACEN_BUCKET=""
ALMACEN_CLAVE_ID=""
ALMACEN_CLAVE_SECRETA=""
ALMACEN_URL_PUBLICA=""       # https://fotos.valentiarobotics.com (dirección pública del bucket)
# Espacios de archivos del equipo de hardware: bucket PRIVADO (usa ALMACEN_ENDPOINT y las claves de arriba).
# Vacío en local → carpeta archivos-privados/. En Render es obligatorio para poder subir (DESPLIEGUE.md §6 quinquies).
ALMACEN_PRIVADO_BUCKET=""

# Guiones automáticos (backend/n8n/README.md): clave que n8n manda en la cabecera x-api-key.
# Al menos 32 caracteres; sin ella la API queda cerrada (503). Nunca una clave real aquí.
N8N_API_KEY=""

# Blog automático (backend/n8n/BLOG.md): clave que n8n manda en x-api-key para /api/blog/*.
# Distinta de N8N_API_KEY. Al menos 32 caracteres; sin ella la API del blog responde 503.
BLOG_API_KEY=""
# Opcional: webhook de n8n que recibe cada artículo publicado (https://…)
N8N_PUBLISH_WEBHOOK=""

# Google Analytics 4 (src/config/analitica.ts): G-XXXXXXX. Vacío = apagado. Solo se carga tras aceptar
# las cookies de «Analítica». Se lee al compilar: al cambiarla, volver a desplegar.
NEXT_PUBLIC_GA_ID=""

# Correos (ver src/lib/correo). Con "npm run dev" NUNCA se envían correos reales:
# se muestran en la terminal y en http://localhost:3000/dev/correos.
# En producción: "consola" (no envía nada) o "resend" (envío real con https://resend.com).
CORREO_PROVEEDOR="consola"
# Solo con CORREO_PROVEEDOR="resend":
#   la clave se crea en resend.com → API Keys (empieza por "re_")
RESEND_API_KEY=""
#   el remitente tiene que ser de un dominio verificado en Resend
CORREO_REMITENTE="Valentia <hola@valentiarobotics.com>"
# Quién recibe el aviso de «pedido nuevo pagado» (uno o varios, separados por comas).
# Vacío = todos los administradores de la web.
AVISO_PEDIDOS_EMAIL=""

# Avisos push de los mensajes del equipo (OPCIONAL: sin ellas, las claves se crean solas en la BD)
# VAPID_CLAVE_PUBLICA=""
# VAPID_CLAVE_PRIVADA=""
# VAPID_CONTACTO="mailto:hola@valentiarobotics.com"
# Con `npm run dev`, el reloj de los recordatorios (cada minuto) solo se enciende con esto:
# RECORDATORIOS_EN_DESARROLLO="si"
