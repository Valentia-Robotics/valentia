# Dependencias (se reinstalan con "npm install")
node_modules/

# Archivos generados por Next.js
.next/
out/
build/
next-env.d.ts
*.tsbuildinfo

# Cliente de Prisma generado (se crea con "npm install" o "npm run db:generate")
frontend/src/generated/

# Secretos: el archivo .env NUNCA se sube a git (sí .env.example)
.env
.env*.local
!.env.example

# Base de datos local de pruebas (SQLite)
*.db
*.db-journal
frontend/prisma/dev.db*

# Fotos subidas desde el panel (almacén local; ver src/lib/almacenamiento)
/frontend/subidas/

# Correos de prueba guardados en desarrollo (ver src/lib/correo/consola.ts y /dev/correos)
/frontend/.correos-dev/

# Sistema operativo y editores
.DS_Store
Thumbs.db
*.log
npm-debug.log*

# Nota: la carpeta imagenes/ (originales de la marca) SÍ se guarda en git.

# Resultados de las pruebas con navegador (npm run test:e2e)
**/test-results/
**/playwright-report/

# Copias de seguridad de la base de datos (npm run db:copia): tienen datos personales
/frontend/copias/

# Fotos de prueba de npm run fotos:piezas -- --prueba
/frontend/.fotos-prueba
frontend/AGENTS.md
